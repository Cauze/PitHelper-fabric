<Element dir="TOP_TO_BOTTOM" gap="10" width="GROW" height="GROW">
    <Element width="GROW" height="30" align="LEFT, CENTER" gap="15" dir="LEFT_TO_RIGHT">
        <Text text="Live Pit Events" size="2" color="#FFFFFF"/>
        <Button id="Btn_RefreshEvents" text="Refresh" onClick="refreshEvents"/>
    </Element>
    <Element id="EventScrollWrapper" width="GROW" height="${scrollHeight}" dir="LEFT_TO_RIGHT" gap="8">
        <Element id="EventScrollArea" scroll="false,true" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" gap="5"
                 padding="0,5">
            <Custom id="EventList"/>
        </Element>
        <Scrollbar target="EventScrollArea"/>
    </Element>
</Element>