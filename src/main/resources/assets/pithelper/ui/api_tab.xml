<Element dir="TOP_TO_BOTTOM" gap="10" width="GROW" height="GROW">
    <Element width="GROW" height="30" align="LEFT, CENTER">
        <Text text="API Configuration" size="2" color="#FFFFFF"/>
    </Element>

    <Element id="ApiScrollWrapper" width="GROW" height="${scrollHeight}" dir="LEFT_TO_RIGHT" gap="8">
        <Element id="ApiScroll" scroll="false,true" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" gap="15"
                 padding="0,5">

            <Element bg="#1E4628" radius="6" width="GROW" height="FIT" padding="15" dir="TOP_TO_BOTTOM" gap="10">
                <Text text="PitHelper API Explorer" size="2" color="#32FF64"/>
                <Text text="Search the global database for players, stats, inventories, and specific mystic items."
                      size="1" color="#C8C8C8"/>
                <Element width="GROW" height="FIT" dir="LEFT_TO_RIGHT">
                    <Button id="Btn_OpenExplorer" text="Launch API Explorer" onClick="openExplorer"/>
                </Element>
            </Element>

            <Element bg="#282D37" radius="6" width="GROW" height="FIT" padding="15" dir="TOP_TO_BOTTOM" gap="8">
                <Text text="API Key Management" size="1" color="#FFC832"/>
                <Element dir="LEFT_TO_RIGHT" gap="10" align="LEFT, CENTER">
                    <Text text="${keyDisplay}" size="1" color="#C8C8C8"/>
                    <Custom id="Btn_ToggleHideKey"/>
                    <Custom id="Btn_CopyKey"/>
                </Element>
                <Element dir="LEFT_TO_RIGHT" gap="10">
                    <Button id="Btn_GenerateLocalKey" text="Register New Key" onClick="generateKey"/>
                    <Custom id="Btn_ClearKey"/>
                </Element>
                <Text text="${keyStatus}" size="1" color="#B4B4B4"/>
            </Element>

            <Element bg="#282D37" radius="6" width="GROW" height="FIT" padding="15" dir="TOP_TO_BOTTOM" gap="8">
                <Text text="Live Server Rate Limits" size="1" color="#FFC832"/>
                <Text text="${limitText}" size="1" color="#C8C8C8"/>
                <Text text="${remainingText}" size="1" color="#C8C8C8"/>
                <Text text="${resetText}" size="1" color="#C8C8C8"/>
            </Element>

        </Element>
        <Scrollbar target="ApiScroll"/>
    </Element>
</Element>