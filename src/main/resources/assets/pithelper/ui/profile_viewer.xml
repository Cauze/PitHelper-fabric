<Element id="ProfileWindow" bg="#181A1E" radius="10" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" padding="20"
         gap="15">
    <Element dir="LEFT_TO_RIGHT" align="LEFT, CENTER" gap="20" width="GROW" height="FIT">
        <Text text="${profileTitle}" size="2" color="#FFFFFF"/>
        <Button id="Btn_CloseProfile" text="Go Back" onClick="closeScreen"/>
    </Element>
    <Element dir="LEFT_TO_RIGHT" gap="8" width="GROW" height="FIT">
        <Tab id="Tab_Main" text="Main Info" active="${isTabMain}" onClick="setTabMain"/>
        <Tab id="Tab_Stats" text="Combat Stats" active="${isTabStats}" onClick="setTabStats"/>
        <Tab id="Tab_Profile" text="Perks &amp; Streaks" active="${isTabProfile}" onClick="setTabProfile"/>
        <Tab id="Tab_Inv" text="Inventories" active="${isTabInv}" onClick="setTabInv"/>
    </Element>
    <Element id="ContentWrapper" width="GROW" height="${scrollHeight}" dir="LEFT_TO_RIGHT" gap="8">
        <Element id="${scrollId}" scroll="false,true" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" gap="10">
            <Custom id="DynamicContent"/>
        </Element>
        <Scrollbar target="${scrollId}"/>
    </Element>
</Element>