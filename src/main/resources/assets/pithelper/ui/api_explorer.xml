<Element id="ExplorerWindow" bg="#181A1E" radius="10" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" padding="20"
         gap="15">
    <Element dir="LEFT_TO_RIGHT" align="LEFT, CENTER" gap="20" width="GROW" height="30">
        <Text text="PitHelper API Explorer" size="2" color="#32FF64"/>
        <Element width="GROW" height="0"/>
        <Button id="Btn_CloseExplorer" text="Go Back" onClick="closeScreen"/>
    </Element>
    <Element dir="LEFT_TO_RIGHT" gap="8" width="GROW" height="FIT">
        <Tab id="Tab_PlayerSearch" text="Player Database" active="${isTabPlayer}" onClick="setTabPlayer"/>
        <Tab id="Tab_ItemSearch" text="Global Item Search" active="${isTabItem}" onClick="setTabItem"/>
        <Tab id="Tab_LobbySearch" text="Lobby Explorer" active="${isTabLobby}" onClick="setTabLobby"/>
    </Element>
    <Element id="ContentWrapper" width="GROW" height="${scrollHeight}" dir="LEFT_TO_RIGHT" gap="8">
        <Element id="${scrollId}" scroll="false,true" width="GROW" height="GROW" dir="TOP_TO_BOTTOM" gap="10"
                 padding="0,5">
            <Custom id="DynamicContent"/>
        </Element>
        <Scrollbar target="${scrollId}"/>
    </Element>
</Element>